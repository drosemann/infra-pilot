# Management Panel - Environment Configuration
# Copy to .env.local for local development

# Backend
PORT=3001
NODE_ENV=development

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
# Full public HTTPS ingress URL, including the webhook route; set for your deployment.
# Example matching helm/infra-pilot/values.yaml: https://api.infra-pilot.example.com/webhook/gitops
VITE_PUBLIC_WEBHOOK_URL=
VITE_ENVIRONMENT=development
VITE_DEMO_FEATURE_ENABLED=false

# Supabase (optional - for hosted features)
# The anon key is public by design; set a real one for your project in production.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=local-dev-anon-key

# PostgreSQL
DATABASE_URL=postgresql://infra_pilot@localhost:5432/infra_pilot

# Redis
REDIS_URL=redis://localhost:6379

# Allowed browser origins for CORS (comma-separated; empty = deny all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Service URLs
INTEGRATION_SERVICE_URL=http://localhost:9000

# Orchestrator (enables deployment forwarding and the Living Fleet proxy).
# ORCHESTRATOR_API_TOKEN is the orchestrator's FEDERATION_API_TOKEN value.
ORCHESTRATOR_URL=http://localhost:8500
ORCHESTRATOR_API_TOKEN=

# Management Panel - Environment Configuration
# Copy to .env.local for local development

# Backend
PORT=3001
NODE_ENV=development

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
# Full public HTTPS ingress URL, including the webhook route; set for your deployment.
# Example matching helm/infra-pilot/values.yaml: https://api.infra-pilot.example.com/webhook/gitops
VITE_PUBLIC_WEBHOOK_URL=
VITE_ENVIRONMENT=development
VITE_DEMO_FEATURE_ENABLED=false

# Supabase (optional - for hosted features)
# The anon key is public by design; set a real one for your project in production.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=local-dev-anon-key

# PostgreSQL
DATABASE_URL=postgresql://infra_pilot@localhost:5432/infra_pilot

# Redis
REDIS_URL=redis://localhost:6379

# Allowed browser origins for CORS (comma-separated; empty = deny all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# WebSocket gateway (authenticated, per-app authorization)
# HMAC key for short-lived WS handshake tickets (min 32 chars; generate with
# `openssl rand -base64 32`). Leave unset for development: the server then
# uses an ephemeral per-process secret, which invalidates in-flight tickets on
# restart and does not validate across replicas.
WS_TICKET_SECRET=
# Ticket lifetime in seconds (clamped to 30-300; default 300 = 5 minutes).
WS_TICKET_TTL_SECONDS=300
# Clock-skew tolerance for ticket nbf/exp checks, seconds (0-60; default 30).
WS_TICKET_SKEW_SECONDS=30
# Milliseconds allowed for the client to present a ticket (500-60000; default 5000).
WS_AUTH_TIMEOUT_MS=5000
# Seconds without activity before a session is closed (30-86400; default 1800).
WS_IDLE_TIMEOUT_SECONDS=1800
# Seconds between heartbeat pings (5-300; default 30).
WS_HEARTBEAT_INTERVAL_SECONDS=30
# Maximum concurrent WebSocket sessions per user (1-100; default 10).
WS_MAX_SESSIONS_PER_USER=10
# Session cap policy when the limit is reached: kick-oldest or reject.
WS_SESSION_LIMIT_POLICY=kick-oldest
# Inbound messages allowed per minute per connection (10-6000; default 120).
WS_MAX_MESSAGES_PER_MINUTE=120
# Log/metric subscribe attempts per minute per user (1-600; default 30).
WS_MAX_SUBSCRIBES_PER_MINUTE=30
# Consecutive rate-limit denials tolerated before disconnect (1-1000; default 20).
WS_MAX_RATE_STRIKES=20
# Protocol or ACL violations tolerated before disconnect (1-100; default 5).
WS_MAX_VIOLATIONS=5
# Maximum inbound WebSocket frame size in bytes (1024-1048576; default 65536).
WS_MAX_MESSAGE_BYTES=65536

# Service URLs
INTEGRATION_SERVICE_URL=http://localhost:9000

# SSO / OIDC (server/sso/)
# HMAC secret for panel SSO session tokens and cookies (min 32 chars;
# generate with `openssl rand -base64 32`). REQUIRED for SSO logins;
# CHANGE_ME placeholder values are refused at runtime.
SESSION_SECRET=
# Public URL callers use to reach the panel API; builds the OIDC redirect
# URI (`<PANEL_PUBLIC_URL>/api/sso/callback/<provider>`). Without it the
# callback derives the base from the request's forwarded headers.
PANEL_PUBLIC_URL=
# Where the SPA is served; SSO callbacks redirect to it with the session
# token in the URL fragment. Defaults to PANEL_PUBLIC_URL / request origin.
PANEL_FRONTEND_URL=
# Panel SSO session lifetime, whole hours (1-168; default 12).
PANEL_SESSION_TTL_HOURS=12
# Service-role Supabase key: REQUIRED for SSO identity linking / JIT
# provisioning (auth admin API). Never expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# OIDC provider configuration. Each provider is enabled only when its
# client id AND client secret are set. Redirect URI to register at the IdP:
#   <PANEL_PUBLIC_URL>/api/sso/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER_URL=https://accounts.google.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Entra tenant id (or set MICROSOFT_ISSUER_URL to a full tenant v2.0 issuer)
MICROSOFT_TENANT_ID=
MICROSOFT_ISSUER_URL=
# Generic OIDC provider (Keycloak, Authentik, Auth0, ...)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# JIT gating: comma-separated exact emails and/or domains. At least one
# list must match when either is set; nobody is admitted from any other
# address. Unset both = any IdP-verified email may self-register.
SSO_EMAIL_ALLOWLIST=
SSO_EMAIL_DOMAIN_ALLOWLIST=

# Orchestrator Agent - Environment Configuration
# Copy to .env and configure

# Discord Bot Token (used by orchestrator agent)
DISCORD_BOT_TOKEN=

# PostgreSQL Database
DATABASE_URL=postgresql://infra_pilot@localhost:5432/infra_pilot
DB_HOST=localhost
DB_PORT=5432
DB_USER=infra_pilot
DB_PASSWORD=
DB_NAME=infra_pilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Webhook
GITOPS_WEBHOOK_PORT=8500
# GitHub webhook secret (HMAC verification; fail-closed if empty)
GITHUB_WEBHOOK_SECRET=
# Bearer token for /webhook/gitops (fail-closed if empty)
GITOPS_WEBHOOK_TOKEN=
# Seconds a webhook timestamp/delivery stays valid against replay
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Docker / Container Registry
REGISTRY=ghcr.io
IMAGE_TAG=latest

# Server Limits
SERVER_LIMIT=1
RAM_LIMIT=1g
DEFAULT_IMAGE=ubuntu-22.04-with-tmate

# Auto-Scaling
AUTO_SCALE_COOLDOWN_MINUTES=5
AUTO_SCALE_CPU_THRESHOLD=80.0
AUTO_SCALE_MEMORY_THRESHOLD=80.0

# Federation API token (required in production; /api/ routes fail closed without it)
FEDERATION_API_TOKEN=

# Living Fleet (optional; off by default)
LIVING_FLEET_ENABLED=false
LIVING_FLEET_INTERVAL_S=60
LIVING_FLEET_DB=/data/living_fleet.db

# Disable service
ORCHESTRATOR_AGENT_DISABLED=true

# Secrets backend (secrets_service.py): none (default) | vault | aws
# hvac/boto3 are optional deps in requirements-optional.txt.
SECRETS_BACKEND=none
SECRETS_CACHE_TTL=60
# Vault connection (AppRole recommended over a static token):
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# AWS Secrets Manager:
AWS_REGION=us-east-1
AWS_PROFILE=
